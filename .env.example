# Copiá a .env (local) o cargá estas variables en Coolify. Nunca subas .env a git.

# --- Accesos (los mismos correos del panel de Puma Code) ---
# El PRIMER correo de ADMIN_EMAILS es el superadmin; los demás son admin. Se crean al primer arranque.
ADMIN_EMAILS=tu@correo.com,mauro@correo.com
VIEWER_EMAILS=
# Clave inicial de esos accesos (cada uno debe cambiarla al primer ingreso). Si la dejás vacía se genera una
# al azar y se imprime en el log de arranque.
BOOTSTRAP_PASSWORD=

# --- Informe hablado con IA (opcional). Sin clave usa texto de plantilla, costo cero ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_CALLS=20

# --- Voz natural de Puma (OpenAI TTS, usa la misma clave). Cuesta ~1,5 a 3 centavos de dólar por minuto de voz.
# Tope diario de caracteres (8000 ≈ 8 min). Poné 0 para apagarla y usar la voz del navegador (gratis).
TTS_DAILY_CHARS=8000
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash

# --- Sitios extra a vigilar, separados por coma. Los que tienen dominio en Coolify/Traefik se descubren solos.
# Formato: https://sitio.com  o  proyecto=https://sitio.com (lo asocia al reloj de ese proyecto) ---
EXTRA_URLS=https://puma-code.com,https://api2.puma-code.com,https://kalyber.com.ar,https://api.kalyber.com.ar,https://mendozapp.com.ar,https://api.mendozapp.com.ar,https://agrotech-pumacode.com.ar,https://api.agrotech-pumacode.com.ar,https://goodtrip.com.ar,https://mendoza-reserve.co.uk

# --- Terminal (solo admins). En el VPS entra por SSH a un usuario sin privilegios: ver README ---
TERMINAL_ENABLED=1

# --- Capa extra opcional: Cloudflare Access delante del login propio ---
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Tope diario de mensajes al chat de Puma (aparte del informe)
AGENT_DAILY_CALLS=150
